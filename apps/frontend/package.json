{
  "name": "omicron-frontend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "check": "greenly",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.59.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "better-auth": "1.7.10",
    "bits-ui": "2.19.5",
    "compression": "1.8.2",
    "d3-geo": "3.1.1",
    "emoji-picker-element": "1.29.1",
    "highlight.js": "11.12.0",
    "i18n-iso-countries": "7.14.0",
    "tiptap-markdown": "0.9.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/d3-geo": "3.1.1",
    "@types/node": "24.19.2",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "greenly": "1.2.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.11.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.11.0"
  }
}
