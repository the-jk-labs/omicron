{
  "name": "omicron-frontend",
  "version": "2.2.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "check": "greenly",
    "test": "vitest run",
    "test:accessibility": "vitest run -t accessibility",
    "test:browser": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "svelte-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.27",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.79.0",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "better-auth": "1.7.27",
    "bits-ui": "2.22.0",
    "compression": "1.8.2",
    "emoji-picker-element": "1.29.1",
    "highlight.js": "11.12.0",
    "tiptap-markdown": "0.9.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@omicron/contract": "link:../../packages/contract",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "greenly": "1.4.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.11.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.11.0"
  },
  "packageManager": "pnpm@12.16.1"
}
