{
  "name": "omicron-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "prebuild": "expo prebuild --platform android",
    "prebuild:dev": "cross-env APP_VARIANT=development expo prebuild --platform android --clean",
    "android": "cross-env APP_VARIANT=development expo run:android",
    "ios": "cross-env APP_VARIANT=development expo run:ios",
    "check": "greenly",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eas-build-dev": "eas build --platform android --profile development",
    "eas-build-prod": "eas build --platform android --profile production",
    "eas-update": "eas update --platform android --channel production --environment production --clear-cache",
    "install:skills": "pnpx skills@latest experimental_install",
    "react-native-doctor": "react-doctor --verbose",
    "editor:build": "vite build --config ./editor-web/vite.config.mts && node ./node_modules/@10play/tentap-editor/scripts/buildEditor.js ./editor-web/build/index.html",
    "editor:dev": "vite --config ./editor-web/vite.config.mts",
    "icons": "node scripts/generate-icons.mts"
  },
  "dependencies": {
    "@10play/tentap-editor": "1.1.0",
    "@better-auth/expo": "1.7.14",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/source-sans-3": "0.4.2",
    "@expo/ui": "58.0.25",
    "@gorhom/bottom-sheet": "5.2.14",
    "@legendapp/list": "3.7.0",
    "@omicron/contract": "link:../../packages/contract",
    "@react-native-vector-icons/lucide": "14.0.0",
    "@tanstack/query-async-storage-persister": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "better-auth": "1.7.14",
    "date-fns": "4.4.0",
    "expo": "58.0.21",
    "expo-application": "58.1.2",
    "expo-build-properties": "58.0.11",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.17",
    "expo-font": "58.0.11",
