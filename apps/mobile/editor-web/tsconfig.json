{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@10play/tentap-editor": ["../node_modules/@10play/tentap-editor/lib-web/typescript/webEditorUtils/index.d.ts"],
      "#lib/*": ["../../frontend/src/lib/*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["*.ts", "*.tsx"]
}
