{
  "license": "AGPL-3.0-or-later",
  "tasks": {
    "dev": "deno run --watch -A src/main.ts",
    "start": "deno run -A src/main.ts",
    "db:generate": "deno run -A npm:drizzle-kit@^0.31 generate",
    "db:studio": "deno run -A npm:drizzle-kit@^0.31 studio",
    "backfill:markdown": "deno run -A scripts/backfill_markdown.ts",
    "backfill:sanitize": "deno run -A scripts/backfill_sanitize.ts",
    "check": "deno check src/main.ts",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "hono": "jsr:@hono/hono@4.12.32",
    "hono/logger": "jsr:@hono/hono@4.12.32/logger",
    "hono/cookie": "jsr:@hono/hono@4.12.32/cookie",
    "hono/factory": "jsr:@hono/hono@4.12.32/factory",
    "hono/deno": "jsr:@hono/hono@4.12.32/deno",
    "@fedify/fedify": "jsr:@fedify/fedify@2.3.3",
    "@fedify/fedify/vocab": "jsr:@fedify/fedify@2.3.3/vocab",
    "@fedify/redis": "jsr:@fedify/redis@2.3.3",
    "ioredis": "npm:ioredis@^5.8.2",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "drizzle-kit": "npm:drizzle-kit@0.31.10",
    "postgres": "npm:postgres@^3.4",
    "bcryptjs": "npm:bcryptjs@^3.0",
    "sanitize-html": "npm:sanitize-html@2.17.6",
    "markdown-it": "npm:markdown-it@14.3.0",
    "@types/markdown-it": "npm:@types/markdown-it@14.1.2",
    "@vscode/markdown-it-katex": "npm:@vscode/markdown-it-katex@1.1.2",
    "zod": "npm:zod@^4.0",
    "@std/assert": "jsr:@std/assert@^1.0",
    "@/": "./src/"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lock": false
}
