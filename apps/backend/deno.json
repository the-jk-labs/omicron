{
  "license": "AGPL-3.0-or-later",
  "tasks": {
    "dev": "deno run --watch -A src/main.ts",
    "start": "deno run -A src/main.ts",
    "db:generate": "deno run -A npm:drizzle-kit@^0.31 generate",
    "db:studio": "deno run -A npm:drizzle-kit@^0.31 studio",
    "backfill:markdown": "deno run -A scripts/backfill_markdown.ts",
    "backfill:sanitize": "deno run -A scripts/backfill_sanitize.ts",
    "backfill:math": "deno run -A scripts/backfill_math.ts",
    "backfill:unescape": "deno run -A scripts/backfill_unescape.ts",
    "backfill:email-lowercase": "deno run -A scripts/backfill_email_lowercase.ts",
    "check": "deno check src/main.ts",
    "test": "deno test -A",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "hono": "jsr:@hono/hono@4.13.2",
    "hono/logger": "jsr:@hono/hono@4.13.2/logger",
    "hono/cookie": "jsr:@hono/hono@4.13.2/cookie",
    "hono/factory": "jsr:@hono/hono@4.13.2/factory",
    "hono/deno": "jsr:@hono/hono@4.13.2/deno",
    "@fedify/fedify": "jsr:@fedify/fedify@2.3.4",
    "@fedify/fedify/vocab": "jsr:@fedify/fedify@2.3.4/vocab",
    "@fedify/redis": "jsr:@fedify/redis@2.3.4",
    "ioredis": "npm:ioredis@^6.0.0",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "drizzle-kit": "npm:drizzle-kit@0.31.10",
    "postgres": "npm:postgres@^3.4",
    "bcryptjs": "npm:bcryptjs@^3.0",
    "sanitize-html": "npm:sanitize-html@2.17.7",
    "markdown-it": "npm:markdown-it@15.0.0",
    "@vscode/markdown-it-katex": "npm:@vscode/markdown-it-katex@1.1.2",
    "katex": "npm:katex@0.18.4",
    "@imagemagick/magick-wasm": "npm:@imagemagick/magick-wasm@0.0.42",
    "@imagemagick/magick-wasm/magick.wasm": "npm:@imagemagick/magick-wasm@0.0.42/magick.wasm",
    "zod": "npm:zod@^4.0",
    "@std/assert": "jsr:@std/assert@^1.0",
    "@/": "./src/"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lock": false
}
