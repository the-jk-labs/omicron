{
  "name": "omicron-backend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "deno run --watch -A src/main.ts",
    "start": "deno run -A src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "check": "greenly",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "backfill:markdown": "deno run -A scripts/backfill_markdown.ts",
    "backfill:sanitize": "deno run -A scripts/backfill_sanitize.ts",
    "backfill:math": "deno run -A scripts/backfill_math.ts",
    "backfill:unescape": "deno run -A scripts/backfill_unescape.ts",
    "backfill:email-lowercase": "deno run -A scripts/backfill_email_lowercase.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.10",
    "@fedify/fedify": "2.4.4",
    "@fedify/redis": "2.4.4",
    "@hono/zod-validator": "0.9.1",
    "@imagemagick/magick-wasm": "0.0.44",
    "@vscode/markdown-it-katex": "1.1.2",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.10",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "isbot": "5.2.2",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "maxmind": "5.0.7",
    "postgres": "3.4.9",
    "sanitize-html": "2.18.1",
    "srvx": "1.0.6",
    "ua-parser-js": "2.0.10",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/sanitize-html": "2.16.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "greenly": "1.2.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.11.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.11.0"
  }
}
