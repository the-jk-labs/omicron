{
  "name": "omicron-backend",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "deno run --watch -A src/main.ts",
    "start": "deno run -A src/main.ts",
    "db:generate": "deno run -A npm:drizzle-kit generate",
    "db:studio": "deno run -A npm:drizzle-kit studio",
    "check": "greenly",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run src/",
    "test:integration": "deno run -A npm:vitest run tests/integration/ --no-file-parallelism",
    "backfill:markdown": "deno run -A scripts/backfill_markdown.ts",
    "backfill:sanitize": "deno run -A scripts/backfill_sanitize.ts",
    "backfill:math": "deno run -A scripts/backfill_math.ts",
    "backfill:unescape": "deno run -A scripts/backfill_unescape.ts",
    "backfill:email-lowercase": "deno run -A scripts/backfill_email_lowercase.ts"
  },
  "dependencies": {
    "@fedify/fedify": "2.3.6",
    "@fedify/redis": "2.3.6",
    "@hono/zod-validator": "0.9.1",
    "@imagemagick/magick-wasm": "0.0.43",
    "@vscode/markdown-it-katex": "1.1.2",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.5",
    "ioredis": "6.0.0",
    "katex": "0.18.5",
    "markdown-it": "15.0.1",
    "postgres": "3.4.9",
    "sanitize-html": "2.17.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/deno": "2.7.0",
    "@types/node": "26.4.1",
    "@types/sanitize-html": "2.16.1",
    "drizzle-kit": "0.31.10",
    "greenly": "1.1.6",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "vitest": "5.0.0"
  }
}
