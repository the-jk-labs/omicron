# Environment for the test suite, loaded by src/config.ts through dotenv
# (vitest.config.ts points DOTENV_PATH here). Real environment variables still
# win, so CI's DATABASE_URL reaches the integration suite unchanged. A
# developer's own apps/backend/.env is never read by the tests.
DATABASE_URL=postgres://omicron:omicron@localhost:5432/omicron_test
SESSION_SECRET=unit-test-session-secret-not-a-real-key
